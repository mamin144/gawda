{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["@tarquinen/opencode-dcp@latest"],
  "mcp": {
    "servers": {
      "supabase": {
        "type": "remote",
        "url": "https://mcp.supabase.com/mcp?project_ref=kbjsonvnbbhvczttvzhv&read_only=true&features=docs,database,debugging,development"
      },
      "dart": {
        "type": "local",
        "command": ["dart", "mcp-server"]
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      }
    }
  },
  "permissions": [
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
    { "action": "shell", "resource": "git push --force*", "effect": "deny" },
    { "action": "shell", "resource": "supabase db reset*", "effect": "deny" },
    { "action": "shell", "resource": "supabase projects delete*", "effect": "deny" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.xlsx", "effect": "deny" },
    { "action": "read", "resource": "*.xlsm", "effect": "deny" }
  ]
}
