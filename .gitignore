# Environment files and secrets
.env*
# Flutter env files hold URL + publishable key; only the placeholder example is committed (P2)
/app/env/*
!/app/env/*.example.json
*.xlsx
*.xlsm

# Build outputs (any depth, so app/build and app/.dart_tool are covered too)
build/
.dart_tool/
.firebase/

# Supabase CLI local state (never committed; supabase/functions and migrations ARE committed)
supabase/.temp/
supabase/.branches/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Operating system
.DS_Store
Thumbs.db

# Claude Code personal overrides (never committed)
.claude/settings.local.json
